# Copy this file to .env and fill in real values. .env is git-ignored.
# Trillion runs without any of these (offline FakeProvider + text mode),
# but each unlocks a layer:

# The brain — Claude via the Anthropic API (Tier 1+)
ANTHROPIC_API_KEY=

# The ears — Deepgram speech-to-text (Tier 3, --voice)
DEEPGRAM_API_KEY=

# The mouth — ElevenLabs text-to-speech (Tier 3, --voice)
ELEVENLABS_API_KEY=
