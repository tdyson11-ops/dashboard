rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user app state (training log, meals, notes, habits, focus).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Latest WHOOP numbers, written by the Cloud Function. Signed-in clients
    // read them; nobody writes from the client.
    match /system/whoop_latest {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // The WHOOP refresh token. No client may ever read or write this — only
    // the Admin SDK inside Cloud Functions, which bypasses these rules.
    match /system/whoop_token {
      allow read, write: if false;
    }

    // Anything else under /system stays closed.
    match /system/{document=**} {
      allow read, write: if false;
    }
  }
}
